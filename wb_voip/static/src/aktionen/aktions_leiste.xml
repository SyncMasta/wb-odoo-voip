<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="wb_voip.AktionsLeiste">
        <t t-foreach="sichtbar" t-as="aktion" t-key="aktion.id">
            <button type="button" class="o_wb_voip_aktion btn"
                    t-att-class="(props.itemKlasse || '') + ' ' + aktion.klasse"
                    t-on-click="() => props.onAusfuehren(aktion.id)">
                <i t-if="aktion.icon" class="fa me-1" t-att-class="aktion.icon" aria-hidden="true"/>
                <t t-esc="aktion.name"/>
            </button>
        </t>
        <Dropdown t-if="mehr.length">
            <button type="button" class="o_wb_voip_aktion_mehr btn btn-outline-secondary"
                    aria-label="Weitere Aktionen">
                Mehr
            </button>
            <t t-set-slot="content">
                <DropdownItem t-foreach="mehr" t-as="aktion" t-key="aktion.id"
                              class="o_wb_voip_aktion_mehr_eintrag"
                              onSelected="() => props.onAusfuehren(aktion.id)">
                    <i t-if="aktion.icon" class="fa me-1" t-att-class="aktion.icon" aria-hidden="true"/>
                    <t t-esc="aktion.name"/>
                </DropdownItem>
            </t>
        </Dropdown>
    </t>
</templates>
