<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.PhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <button t-if="wbVoipZeigen" type="button"
                    class="o_wb_voip_waehlen btn btn-link p-0 ms-2 d-inline-flex align-items-center"
                    title="Call with the softphone" aria-label="Call with the softphone"
                    t-on-click="wbVoipWaehlen">
                <i class="fa fa-phone" aria-hidden="true"/>
            </button>
        </xpath>
    </t>
    <!-- Primäres Erbe: Erweiterungen von web.PhoneField greifen hier nicht -->
    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]" position="inside">
            <button t-if="wbVoipZeigen" type="button"
                    class="o_wb_voip_waehlen btn btn-link p-0 ms-2 d-inline-flex align-items-center"
                    title="Call with the softphone" aria-label="Call with the softphone"
                    t-on-click="wbVoipWaehlen">
                <i class="fa fa-phone" aria-hidden="true"/>
            </button>
        </xpath>
    </t>
</templates>
