<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wb_voip_zuordnen_view_form" model="ir.ui.view">
        <field name="name">wb.voip.zuordnen.form</field>
        <field name="model">wb.voip.zuordnen</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="anruf_id" invisible="1"/>
                    <field name="nummer"/>
                    <field name="partner_id" required="1"/>
                    <field name="feld"/>
                    <field name="ersetzen" invisible="feld == 'nicht_speichern'"/>
                </group>
                <footer>
                    <button name="action_zuordnen" type="object" string="Assign"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"
                            data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
