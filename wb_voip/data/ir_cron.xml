<?xml version="1.0" encoding="utf-8"?>
<!-- noupdate: Administratoren dürfen Takt und Aktivierung ändern, Updates überschreiben das nicht -->
<odoo noupdate="1">
    <record id="ir_cron_voip_aufraeumen" model="ir.cron">
        <field name="name">WB VoIP: Clean up orphaned calls</field>
        <field name="model_id" ref="model_wb_voip_anruf"/>
        <field name="state">code</field>
        <field name="code">model._wb_voip_aufraeumen()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_voip_loeschfrist" model="ir.cron">
        <field name="name">WB VoIP: Retention period for call data</field>
        <field name="model_id" ref="model_wb_voip_anruf"/>
        <field name="state">code</field>
        <field name="code">model._wb_voip_loeschfrist()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
