<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wb_voip_res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.form.wb_voip</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_wb_voip_protokolle" type="object" class="oe_stat_button"
                        icon="fa-phone" groups="wb_voip.group_wb_voip_user">
                    <field name="wb_voip_protokoll_anzahl" widget="statinfo" string="Anrufe"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
