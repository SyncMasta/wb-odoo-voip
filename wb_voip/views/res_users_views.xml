<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mein Profil (Einstellungen des Benutzers) -->
    <record id="wb_voip_res_users_view_form_simple" model="ir.ui.view">
        <field name="name">res.users.preferences.form.wb_voip</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences_page']" position="after">
                <page string="Telephony" name="wb_voip" groups="wb_voip.group_wb_voip_user">
                    <group>
                        <field name="wb_voip_anlage_id" readonly="1"/>
                        <field name="wb_voip_sip_benutzer" readonly="1"/>
                        <field name="wb_voip_sip_passwort_gesetzt" invisible="1"/>
                        <field name="wb_voip_sip_passwort" password="True" readonly="0"
                               placeholder="Enter new password"/>
                        <div colspan="2" class="text-muted"
                             invisible="not wb_voip_sip_passwort_gesetzt">
                            Saved – enter again to change
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Benutzerformular der Administration -->
    <record id="wb_voip_res_users_view_form" model="ir.ui.view">
        <field name="name">res.users.form.wb_voip</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='preferences']" position="after">
                <page string="Telephony" name="wb_voip">
                    <group>
                        <field name="wb_voip_anlage_id"
                               groups="wb_voip.group_wb_voip_manager"/>
                        <field name="wb_voip_sip_benutzer"
                               groups="wb_voip.group_wb_voip_manager"/>
                        <field name="wb_voip_anlage_id" readonly="1"
                               groups="!wb_voip.group_wb_voip_manager"/>
                        <field name="wb_voip_sip_benutzer" readonly="1"
                               groups="!wb_voip.group_wb_voip_manager"/>
                        <field name="wb_voip_sip_passwort_gesetzt" invisible="1"
                               groups="wb_voip.group_wb_voip_manager"/>
                        <field name="wb_voip_sip_passwort" password="True"
                               placeholder="Enter new password"
                               groups="wb_voip.group_wb_voip_manager"/>
                        <div colspan="2" class="text-muted"
                             groups="wb_voip.group_wb_voip_manager"
                             invisible="not wb_voip_sip_passwort_gesetzt">
                            Saved – enter again to change
                        </div>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
