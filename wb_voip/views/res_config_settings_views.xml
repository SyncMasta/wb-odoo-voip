<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wb_voip_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wb_voip</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WB VoIP" string="WB VoIP" name="wb_voip"
                     groups="wb_voip.group_wb_voip_manager">
                    <block title="WB VoIP" name="wb_voip_block">
                        <setting string="Retention period for call data"
                                 help="Delete ended calls after this number of months (0 = never). Call logs are kept.">
                            <field name="wb_voip_aufbewahrung_monate"/>
                        </setting>
                        <setting string="Show team overview"
                                 help="&quot;Team&quot; tab in the softphone: presence and phone status of colleagues. Before switching it on, inform the employees and, where applicable, involve the works council.">
                            <field name="wb_voip_team_aktiv"/>
                        </setting>
                        <setting string="Show call duration in the team" invisible="not wb_voip_team_aktiv"
                                 help="Shows in the team overview since when a colleague has been on a call.">
                            <field name="wb_voip_team_dauer"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
