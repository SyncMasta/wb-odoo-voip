<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wb_voip_res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wb_voip</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="WB VoIP" string="WB VoIP" name="wb_voip"
                     groups="wb_voip.group_wb_voip_manager">
                    <block title="WB VoIP" name="wb_voip_block">
                        <setting string="Löschfrist für Anrufdaten"
                                 help="Beendete Anrufe nach dieser Zahl von Monaten löschen (0 = nie). Anrufprotokolle bleiben erhalten.">
                            <field name="wb_voip_aufbewahrung_monate"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
