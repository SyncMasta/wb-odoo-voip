<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wb_voip_layout_view_list" model="ir.ui.view">
        <field name="name">wb.voip.layout.list</field>
        <field name="model">wb.voip.layout</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="ort"/>
                <field name="breite"/>
                <field name="group_ids" widget="many2many_tags" optional="show"/>
                <field name="ist_standard" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="wb_voip_layout_view_form" model="ir.ui.view">
        <field name="name">wb.voip.layout.form</field>
        <field name="model">wb.voip.layout</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_auf_standard_zuruecksetzen" type="object"
                            string="Auf Standard zurücksetzen"
                            invisible="not ist_standard"
                            confirm="Alle Blöcke werden auf den Auslieferungszustand zurückgesetzt. Fortfahren?"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archiviert" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="ort"/>
                            <field name="breite"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="group_ids" widget="many2many_tags"/>
                            <field name="ist_standard"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="block_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="art"/>
                            <field name="titel"/>
                            <field name="spalte"/>
                            <field name="feld_ids" widget="many2many_tags"
                                   invisible="art != 'felder'" required="art == 'felder'"/>
                            <field name="anzahl" invisible="art not in ('protokolle', 'aufgaben')"/>
                            <field name="text" invisible="art != 'text'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wb_voip_layout_action" model="ir.actions.act_window">
        <field name="name">Fenster-Layouts</field>
        <field name="res_model">wb.voip.layout</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
