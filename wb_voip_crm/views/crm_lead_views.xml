<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wb_voip_crm_lead_view_form" model="ir.ui.view">
        <field name="name">crm.lead.form.wb.voip</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_wb_voip_anrufe" type="object" class="oe_stat_button"
                        icon="fa-phone" groups="wb_voip.group_wb_voip_user"
                        invisible="not id">
                    <field name="wb_voip_anruf_anzahl" widget="statinfo" string="Anrufe"/>
                </button>
            </div>
            <notebook position="inside">
                <page string="Anrufprotokolle" name="wb_voip_protokolle"
                      groups="wb_voip.group_wb_voip_user" invisible="not id">
                    <field name="wb_voip_protokoll_ids" readonly="1">
                        <list>
                            <field name="datum"/>
                            <field name="user_id"/>
                            <field name="richtung"/>
                            <field name="partner_id"/>
                            <field name="ergebnis"/>
                            <field name="dauer_sek"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
