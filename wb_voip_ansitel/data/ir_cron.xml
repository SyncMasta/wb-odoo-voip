<?xml version="1.0" encoding="utf-8"?>
<!-- noupdate: Administratoren dürfen Takt und Aktivierung ändern, Updates überschreiben das nicht -->
<odoo noupdate="1">
    <record id="ir_cron_ansitel_abgleich" model="ir.cron">
        <field name="name">WB VoIP Ansitel: Abgleich mit der Anrufliste</field>
        <field name="model_id" ref="wb_voip.model_wb_voip_anlage"/>
        <field name="state">code</field>
        <field name="code">model._wb_voip_ansitel_abgleich_alle()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
