<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Mein Profil: eigenes Handy (nur der Benutzer selbst) -->
    <record id="wb_voip_ansitel_res_users_view_form_simple" model="ir.ui.view">
        <field name="name">res.users.preferences.form.wb_voip_ansitel</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="wb_voip.wb_voip_res_users_view_form_simple"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wb_voip_sip_passwort']/.." position="after">
                <group string="Schnelltasten">
                    <field name="wb_voip_handy" readonly="0" placeholder="+49 30 23125 101"/>
                    <field name="wb_voip_ansitel_tastenleiste" readonly="0"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Benutzerformular der Administration -->
    <record id="wb_voip_ansitel_res_users_view_form" model="ir.ui.view">
        <field name="name">res.users.form.wb_voip_ansitel</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="wb_voip.wb_voip_res_users_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='wb_voip']/group" position="after">
                <group string="Ansitel" groups="wb_voip.group_wb_voip_manager">
                    <field name="wb_voip_ansitel_nebenstelle" groups="base.group_system" placeholder="100"/>
                    <!-- Verwalter ohne Systemrecht sehen die Nebenstelle nur (setzen darf sie die Systemverwaltung) -->
                    <field name="wb_voip_ansitel_nebenstelle" groups="!base.group_system" readonly="1"/>
                    <field name="wb_voip_ansitel_token_gesetzt" invisible="1"/>
                    <field name="wb_voip_ansitel_token" password="True" groups="base.group_system"
                           placeholder="Neuen Token eingeben"/>
                    <div colspan="2" class="text-muted" invisible="not wb_voip_ansitel_token_gesetzt">
                        Persönlicher Token gespeichert – zum Ändern neu eingeben
                    </div>
                    <field name="wb_voip_ansitel_ab_zentral" groups="base.group_system"/>
                    <field name="wb_voip_handy" groups="base.group_system"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
