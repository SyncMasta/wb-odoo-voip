<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wb_voip_geraet_view_list" model="ir.ui.view">
        <field name="name">wb.voip.geraet.list</field>
        <field name="model">wb.voip.geraet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="peer_name"/>
                <field name="nebenstelle"/>
                <field name="anlage_id"/>
                <field name="user_id"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="wb_voip_geraet_view_form" model="ir.ui.view">
        <field name="name">wb.voip.geraet.form</field>
        <field name="model">wb.voip.geraet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="peer_name" placeholder="Tel51"/>
                            <field name="nebenstelle"/>
                        </group>
                        <group>
                            <field name="anlage_id"/>
                            <field name="user_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="wb_voip_geraet_view_search" model="ir.ui.view">
        <field name="name">wb.voip.geraet.search</field>
        <field name="model">wb.voip.geraet</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="peer_name"/>
                <field name="user_id"/>
                <filter name="ohne_benutzer" string="No user" domain="[('user_id', '=', False)]"/>
                <filter name="archiviert" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="wb_voip_geraet_action" model="ir.actions.act_window">
        <field name="name">PBX devices</field>
        <field name="res_model">wb.voip.geraet</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No devices yet</p>
            <p>System administrators load them on the PBX with "Load devices from PBX".
                This way the call list shows on which device a call was answered.</p>
        </field>
    </record>

    <menuitem id="wb_voip_menu_geraet" name="Devices" parent="wb_voip.wb_voip_menu_root"
              action="wb_voip_geraet_action" sequence="65"
              groups="wb_voip.group_wb_voip_manager"/>
</odoo>
